# Contact intake AI (optional to state explicitly; these are the defaults)
INTAKE_PROVIDER=gemini
INTAKE_MODEL=gemini-2.5-flash-lite
INTAKE_RECAP_MODEL=gemini-2.5-flash-lite

# Required for signed follow-up state. Generate a long random value and set it
# only in Netlify or an untracked local environment file.
INTAKE_FOLLOWUP_TOKEN_SECRET=

# Optional contact-intake controls
INTAKE_RATE_LIMIT_MAX=12
INTAKE_RATE_LIMIT_WINDOW_MS=600000
AGENT_NAME=Relay

# Authoritative production delivery
CONTACT_DELIVERY_MODE=smtp
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURE=true
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional secondary delivery. SMTP remains authoritative.
LEAD_WEBHOOK_URL=

# Optional public display copy (these values are bundled in browser code)
NEXT_PUBLIC_AGENT_NAME=Relay
NEXT_PUBLIC_REPLY_WINDOW_TEXT=

# Netlify AI Gateway injects GEMINI_API_KEY and GOOGLE_GEMINI_BASE_URL at
# function runtime. Do not define them here or as owner-managed production
# variables; doing so overrides Netlify-managed Gateway configuration.
