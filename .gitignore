# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
# An agent's own isolated dev-server build dir (CLAUDE_NEXT_DIST_DIR — see
# AGENTS.md's "Local dev server" section), name varies per session.
/.next-*/
/out/
# scripts/verify-release.js's own isolated build/export dirs — never the
# real .next/out, so a release-gate run can't corrupt a concurrent dev
# server's own build cache.
/.next-verify/
/out-verify/
# A local ad-hoc `next build && next export` preview dir, distinct from the
# gate's own /out-verify/ above — recurs as untracked noise in every git
# status this repo's own operators/agents run locally; never meant to be
# tracked.
/out-local-preview/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Storybook (local-only)
.storybook/
storybook-static/
# Local Netlify folder
.netlify

# Copy tool (dev-only)
.copy-tool/generations/
.copy-tool/.bootstrap-snapshot.yaml

# Accidentally-tracked agent scratchpad (/private/tmp/claude-.../scratchpad) —
# never belongs in this repo's history going forward.
/private/
